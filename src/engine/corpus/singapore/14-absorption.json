        "valid": true,
        "patterns": [
          "hiddenTreasure",
          "fullyConcealed"
        ],
        "fan": [
          [
            "hiddenTreasure",
            10
          ],
          [
            "fullyConcealed",
            1
          ]
        ],
        "rawTai": 11,
        "totalTai": 10,
